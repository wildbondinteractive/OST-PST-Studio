{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OST-PST Studio",
  "version": "0.1.3",
  "identifier": "com.wildbondinteractive.ostpststudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OST/PST Studio",
        "label": "main",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "dragDropEnabled": true,
        "theme": null
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-src 'self' about: data: blob:; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDBGRjdBNTg0ODE1RDg3OTUKUldTVmgxMkJoS1gzRHlyS0NrTFFob1hRc0x4Z1Q3OHFtejdqSDNFNk1kN1gydUNOZG1FWDBjNloK",
      "endpoints": [
        "https://github.com/wildbondinteractive/OST-PST-Studio/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "OST/PST Studio contributors",
    "copyright": "MIT License. Engine based on pstfree (MIT).",
    "category": "Utility",
    "shortDescription": "Outlook OST/PST recovery, conversion and export",
    "longDescription": "Open, browse, search, convert, repair and export Outlook OST and PST files without Outlook. Mailboxes are processed locally. MIT licensed.",
    "licenseFile": "../LICENSE",
    "resources": [],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      },
      "wix": {
        "language": "en-US"
      }
    }
  }
}
